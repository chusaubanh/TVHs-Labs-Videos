# ==========================================
# CẤU HÌNH HỆ THỐNG TVHs-Labs-Video
# ==========================================

# Cổng máy chủ đọc giọng VieNeu-TTS (mặc định: http://127.0.0.1:8124)
VIENEU_ENDPOINT=http://127.0.0.1:8124

# Chế độ phần cứng:
# 1 = Bắt buộc có GPU NVIDIA hỗ trợ NVENC (khuyến nghị cho dựng video tốc độ cao)
# 0 = Cho phép chạy trên CPU (không cần NVIDIA, nhưng render chậm hơn)
TVHS_REQUIRE_GPU=1

# Tùy chọn đường dẫn Adobe Bridge (nếu kết nối After Effects / Premiere)
# ADOBE_BRIDGE=D:/Total_AI/04_Agents_MCP_Workflow/Bots_Agents/Em_yeu_khoa_hoc/Adobe/adobe-bridge.cjs
# ADOBE_BRIDGE_OUT=D:/Gom/Em yêu khoa học/Cầu nối adobe/outputs

# Kho repo chỉ đọc: npm run research:connect -- <đường dẫn>.
# TVHS_RESEARCH_ROOT trong môi trường tiến trình có thể ghi đè đường dẫn này.
